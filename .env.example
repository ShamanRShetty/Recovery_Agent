# Database File Path
DB_PATH=db/recovery_agent.db

# Razorpay Webhook Secret (Set this to the secret key configured in Razorpay Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# LLM Fallback API Keys (Set either GEMINI_API_KEY or ANTHROPIC_API_KEY)
GEMINI_API_KEY=your_google_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_claude_api_key_here
